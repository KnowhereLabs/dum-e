<sdf version="1.9"><world name="wall_bench"><physics name="default" type="ignored"><max_step_size>0.001</max_step_size><real_time_factor>1</real_time_factor></physics><plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" /><plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre</render_engine></plugin><model name="wall"><static>true</static><pose>2.5 0 1 0 0 0</pose><link name="link"><visual name="wall"><geometry><box><size>1 20 2</size></box></geometry></visual></link></model><model name="sensor"><static>true</static><pose>0 0 0.5 0 0 0</pose><link name="link"><sensor name="laser" type="gpu_lidar"><always_on>true</always_on><update_rate>10</update_rate><topic>scan_bench</topic><lidar><scan><horizontal><samples>121</samples><resolution>1</resolution><min_angle>-0.75</min_angle><max_angle>0.75</max_angle></horizontal></scan><range><min>0.05</min><max>10</max><resolution>0.001</resolution></range></lidar></sensor></link></model></world></sdf>