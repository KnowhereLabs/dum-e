<sdf version="1.9"><world name="camera_bench"><plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" /><plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre</render_engine></plugin><scene><ambient>.4 .4 .4 1</ambient><background>.3 .3 .3 1</background></scene><light name="sun" type="directional"><pose>0 0 10 0 0 0</pose><cast_shadows>false</cast_shadows><diffuse>.8 .8 .8 1</diffuse><direction>-.5 -.5 -1</direction></light><model name="ground"><static>true</static><pose>0 0 -.05 0 0 0</pose><link name="link"><visual name="visual"><geometry><box><size>20 20 .1</size></box></geometry><material><ambient>.7 .7 .7 1</ambient><diffuse>.7 .7 .7 1</diffuse></material></visual></link></model><model name="red"><static>true</static><pose>2 -.5 .5 0 0 0</pose><link name="link"><visual name="visual"><geometry><box><size>1 1 1</size></box></geometry><material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse></material></visual></link></model><model name="blue"><static>true</static><pose>3 1 .5 0 0 0</pose><link name="link"><visual name="visual"><geometry><box><size>1 1 1</size></box></geometry><material><ambient>0 0 1 1</ambient><diffuse>0 0 1 1</diffuse></material></visual></link></model><model name="plain"><static>true</static><pose>-1 0 .8 0 0 0</pose><link name="link"><sensor name="plain" type="camera"><always_on>true</always_on><update_rate>30</update_rate><topic>camera_plain</topic><camera><horizontal_fov>1.047</horizontal_fov><image><width>320</width><height>240</height><format>R8G8B8</format></image><clip><near>.1</near><far>100</far></clip></camera></sensor></link></model><model name="noise"><static>true</static><pose>-1 0 .8 0 0 0</pose><link name="link"><sensor name="noise" type="camera"><always_on>true</always_on><update_rate>30</update_rate><topic>camera_noise</topic><camera><horizontal_fov>1.047</horizontal_fov><image><width>320</width><height>240</height><format>R8G8B8</format></image><clip><near>.1</near><far>100</far></clip><noise><type>gaussian</type><mean>0</mean><stddev>.007</stddev></noise></camera></sensor></link></model></world></sdf>